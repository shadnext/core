{
  "name": "@shadnext/core",
  "version": "0.0.17",
  "publishConfig": {
    "access": "public",
    "files": ["presets", "presets/**/*"]
  },
  "description": "Beautifully designed components built with StencilJS and TailwindCSS, inspired by shadcn/ui",
  "keywords": [
    "ui",
    "components",
    "web-components",
    "stencil",
    "tailwindcss",
    "shadcn",
    "design-system",
    "typescript",
    "custom-elements"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/cn/cn.esm.js",
  "exports": {
    ".": {
      "import": "./dist/cn/cn.esm.js",
      "require": "./dist/cn/cn.cjs.js"
    },
    "./button": {
      "import": "./dist/components/n-button.js",
      "types": "./dist/components/n-button.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shadnext/core"
  },
  "files": [
    "dist/",
    "loader/",
    "presets/",
    "readme.md"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "npm-run-all --parallel start:stencil start:tailwind",
    "start:stencil": "stencil build --dev --watch --serve",
    "start:tailwind": "tailwindcss -i ./src/global/styles.css -o ./www/build/shadnext.css --watch",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.7.0",
    "@stencil/postcss": "^2.1.0",
    "@stencil/sass": "^3.0.12",
    "@types/jest": "^29.5.6",
    "@types/node": "^16.18.11",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "puppeteer": "^21.9.0",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  }
}
